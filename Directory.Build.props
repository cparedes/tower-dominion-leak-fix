<Project>
  <!--
    Shared build settings. Every fix is built for one loader at a time:

      dotnet build -c Release                         # BepInEx 6 (IL2CPP)  -> bin/BepInEx/
      dotnet build -c Release -p:Loader=MelonLoader   # MelonLoader 0.6+    -> bin/MelonLoader/

    The plugins compile against the Il2CppInterop proxy assemblies the loader generates on its first launch
    (BepInEx/interop or MelonLoader/Il2CppAssemblies), so install that loader and run the game once first.

    Game folder: pass -p:GameDir="..." or set the TOWER_DOMINION_DIR environment variable.
  -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Version>1.3.0</Version>
    <Authors>Tower Dominion community</Authors>
    <Loader Condition="'$(Loader)' == ''">BepInEx</Loader>
    <GameDir Condition="'$(GameDir)' == ''">$(TOWER_DOMINION_DIR)</GameDir>
    <GameDir Condition="'$(GameDir)' == '' And '$(OS)' == 'Windows_NT'">C:\Program Files (x86)\Steam\steamapps\common\Tower Dominion</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">/mnt/c/Program Files (x86)/Steam/steamapps/common/Tower Dominion</GameDir>
    <!-- -p:Deploy=true copies the built plugin into the loader's plugin folder -->
    <Deploy Condition="'$(Deploy)' == ''">false</Deploy>
    <BaseOutputPath>bin/$(Loader)/</BaseOutputPath>
    <BaseIntermediateOutputPath>obj/$(Loader)/</BaseIntermediateOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Loader)' == 'BepInEx'">
    <DefineConstants>$(DefineConstants);BEPINEX</DefineConstants>
    <CoreDir>$(GameDir)/BepInEx/core</CoreDir>
    <InteropDir>$(GameDir)/BepInEx/interop</InteropDir>
    <DeployDir>$(GameDir)/BepInEx/plugins</DeployDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Loader)' == 'MelonLoader'">
    <DefineConstants>$(DefineConstants);MELONLOADER</DefineConstants>
    <!-- MelonLoaderRefs: a folder containing MelonLoader/net6 and MelonLoader/Il2CppAssemblies (defaults to the game) -->
    <MelonLoaderRefs Condition="'$(MelonLoaderRefs)' == ''">$(GameDir)</MelonLoaderRefs>
    <CoreDir>$(MelonLoaderRefs)/MelonLoader/net6</CoreDir>
    <InteropDir>$(MelonLoaderRefs)/MelonLoader/Il2CppAssemblies</InteropDir>
    <DeployDir>$(GameDir)/Mods</DeployDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)src/Common/Loader.cs" Link="Common/Loader.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(Loader)' == 'BepInEx'">
    <Reference Include="$(CoreDir)/BepInEx.Core.dll" Private="false" />
    <Reference Include="$(CoreDir)/BepInEx.Unity.IL2CPP.dll" Private="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(Loader)' == 'MelonLoader'">
    <Reference Include="$(CoreDir)/MelonLoader.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(CoreDir)/0Harmony.dll" Private="false" />
    <Reference Include="$(CoreDir)/Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(InteropDir)/Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="$(InteropDir)/Il2CppSystem.Core.dll" Private="false" />
    <Reference Include="$(InteropDir)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(InteropDir)/UnityEngine.AudioModule.dll" Private="false" />
    <Reference Include="$(InteropDir)/Assembly-CSharp.dll" Private="false" />
  </ItemGroup>

  <Target Name="CheckLoader" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(Loader)' != 'BepInEx' And '$(Loader)' != 'MelonLoader'"
           Text="Unknown Loader '$(Loader)'. Use -p:Loader=BepInEx or -p:Loader=MelonLoader." />
    <Error Condition="!Exists('$(InteropDir)/Assembly-CSharp.dll')"
           Text="$(Loader) interop assemblies not found in '$(InteropDir)'. Install $(Loader), launch the game once, and/or set -p:GameDir=... or TOWER_DOMINION_DIR." />
  </Target>

  <Target Name="DeployPlugin" AfterTargets="Build" Condition="'$(Deploy)' == 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DeployDir)" />
  </Target>
</Project>
